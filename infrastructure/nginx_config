# /etc/nginx/conf.d/app.conf  (Frontend servers)
# Replace INTERNAL-APP-ALB-DNS with the DNS name of the internal App ALB.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Allow document uploads up to 10 MB (plus form overhead)
    client_max_body_size 12m;

    # Static React frontend
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API requests go to the backend tier through the internal App ALB
    location /api/ {
        proxy_pass http://INTERNAL-APP-ALB-DNS;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check for the Web ALB target group
    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
